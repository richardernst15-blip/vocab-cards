{
  // Tells Cloudflare how to deploy this repo. "name" must match the Worker's name in Cloudflare.
  "name": "vocab-cards",
  "main": "worker.js",
  "compatibility_date": "2026-11-01",

  // The shared database. Paste your D1 database ID below (Storage & databases > D1 > vocab-cards).
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "vocab-cards",
      "database_id": "cfd8ea9f-4ca7-43e1-ae61-f6fd740bfc57"
    }
  ]
}
